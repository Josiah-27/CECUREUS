# ------------------------------------------------------------
# CECUREUS — Environment Configuration Template
# ------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cecureus
DB_USER=cecureus_user
DB_PASSWORD=your_secure_db_password_here

# Security
AUTH_TOKEN_SECRET=your_generated_64_byte_hex_secret_here
AUTH_TOKEN_EXPIRY_HOURS=24
BCRYPT_ROUNDS=12

# Gmail SMTP Dispatch (Google App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# SMS Gateway (Optional for production SMS delivery)
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_sms_api_key_here

# Local AI Engine (Microsoft Phi-3 via Ollama)
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=phi3
